{
  "manifest_version": 3,
  "name": "LinguaFin",
  "version": "0.1.0",
  "description": "Rend les services financiers numériques compréhensibles dans d'autres langues, sans modifier leur code.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LinguaFin"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "110",
  "background": {
    "service_worker": "background.js"
  }
}
