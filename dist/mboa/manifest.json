{
  "manifest_version": 3,
  "name": "Mboa — ta banque dans ta langue",
  "short_name": "Mboa",
  "version": "0.1.0",
  "description": "Rend les services financiers en ligne compréhensibles en Ewondo, Duala, Fulfulde et Pidgin. Montants verrouillés, calculs vérifiés, bouclier anti-arnaque, voix. 100 % hors ligne.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "Mboa",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "src/core/ns.js",
        "src/core/icons.js",
        "src/core/entities.js",
        "src/core/detect.js",
        "src/packs/phrases.js",
        "src/packs/blocks.js",
        "src/core/engine.js",
        "src/core/money.js",
        "src/core/shield.js",
        "src/content/dom.js",
        "src/content/voice.js",
        "src/content/ui.js",
        "src/content/main.js"
      ]
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Ouvrir / fermer le panneau Mboa"
    },
    "read-page": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Lire la page à voix haute"
    },
    "toggle-original": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Basculer traduction / original"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mboa@safinum-hackathon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
